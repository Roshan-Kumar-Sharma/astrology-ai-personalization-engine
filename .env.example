# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# mock | anthropic | openai | openrouter
# `mock` needs no key and produces deterministic, grounded answers offline.
# Selecting a provider whose key is missing falls back to mock with a warning
# rather than failing to boot.
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=20000

# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter: one key, many models, and a real no-card free tier.
# Its API is OpenAI-compatible, so it reuses the OpenAI adapter.
# Get a key at https://openrouter.ai/keys - NEVER put a real key in this file.
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://github.com/mynaksh/context-engine
OPENROUTER_APP_NAME=MyNaksh Personalized AI Context Engine


# ---------------------------------------------------------------------------
# Upstream services
# ---------------------------------------------------------------------------
# The bundled mock upstream serves all four services over real HTTP on its own
# port. Point these at real services and set MOCK_UPSTREAM_ENABLED=false to
# take it out of the picture - no code changes required.
MOCK_UPSTREAM_ENABLED=true
MOCK_UPSTREAM_PORT=4010

UPSTREAM_USER_URL=http://127.0.0.1:4010
UPSTREAM_KUNDLI_URL=http://127.0.0.1:4010
UPSTREAM_HOROSCOPE_URL=http://127.0.0.1:4010
UPSTREAM_PANCHANG_URL=http://127.0.0.1:4010

# Fault injection, for demonstrating graceful degradation.
# 0.4 makes roughly 40% of upstream calls return 503.
MOCK_UPSTREAM_FAULT_RATE=0
MOCK_UPSTREAM_LATENCY_MS=40

# ---------------------------------------------------------------------------
# Resilience
# ---------------------------------------------------------------------------
UPSTREAM_TIMEOUT_MS=1200
UPSTREAM_RETRY_ATTEMPTS=2
UPSTREAM_RETRY_BASE_DELAY_MS=60
CONTEXT_FANOUT_DEADLINE_MS=2500

# ---------------------------------------------------------------------------
# Context budget (tokens of astrological context sent to the LLM)
# ---------------------------------------------------------------------------
CONTEXT_TOKEN_BUDGET_FREE=320
CONTEXT_TOKEN_BUDGET_PREMIUM=900

# ---- Intent LLM fallback ---------------------------------------------------
# Escalate genuinely ambiguous questions to the model for classification.
# Off by default. Measure before enabling:
#   npm run eval:gate         which threshold, and what it costs (free)
#   npm run eval:intent-llm   what the lift actually is (spends calls)
INTENT_LLM_FALLBACK=false
# Escalate below this classifier confidence. 0.35 is the measured knee: it means
# "the lexicon found no signal at all", which is 34% of traffic and 66% of all
# intent errors. Above 0.87 escalates nearly everything.
INTENT_LLM_THRESHOLD=0.35
INTENT_LLM_TIMEOUT_MS=4000

# ---- Second-layer safety screen --------------------------------------------
# Ask the model to re-screen questions the deterministic rules allowed. It can
# only ADD a refusal, never remove one, and it fails open on any error.
# Off by default: it screens every allowed question (there is no useful gate --
# the patterns are silent exactly where they fail), so it roughly doubles LLM
# calls on safe traffic. Measure with: npm run eval:safety-llm
SAFETY_LLM_SCREEN=false
SAFETY_LLM_TIMEOUT_MS=4000
